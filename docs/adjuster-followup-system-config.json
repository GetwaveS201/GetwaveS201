  },

  "testing_checklist": {
    "email_qualification": [
      "Test with 20 real emails (10 qualifying, 10 non-qualifying)",
      "Verify 100% accuracy on domain matching",
      "Verify keyword detection on HTML and plain text",
      "Test auto-reply detection",
      "Test CC-only exclusion"
    ],
    "follow_up_schedule": [
      "Create test thread with first contact 10 days ago",
      "Verify business day calculation skips weekends",
      "Verify holidays are excluded",
      "Test 3-day interval enforcement"
    ],
    "stop_conditions": [
      "Mark invoice as paid → verify automation stops",
      "Add 'disputed' keyword in mock reply → verify stops",
      "Manually pause thread → verify no emails sent",
      "Reach 10 follow-ups → verify internal escalation"
    ],
    "safety_mechanisms": [
      "Attempt weekend send → should skip",
      "Attempt send before 3 days → should skip",
      "Thread with status 'paid' → should reject",
      "Unapproved thread → should not send"
    ],
    "email_delivery": [
      "Send test escalation email to team",
      "Verify formatting on mobile and desktop",
      "Verify all variables populate correctly",
      "Test with real email service"
    ]
  },

  "metrics_and_kpis": {
    "track_these_metrics": [
      {
        "metric": "Average days to payment",
        "comparison": "Before automation vs After automation"
      },
      {
        "metric": "Follow-up count at payment",
        "description": "Which follow-up cycle do adjusters typically respond?"
      },
      {
        "metric": "Automation stop reasons",
        "breakdown": "paid, disputed, coverage_issued, paused, etc."
      },
      {
        "metric": "Email open rates",
        "note": "If tracking pixels enabled"
      },
      {
        "metric": "Response rate by carrier",
        "description": "Which carriers respond fastest?"
      }
    ],
    "dashboard_views": [
      "Active threads by carrier",
