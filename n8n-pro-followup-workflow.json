          "payment_likelihood": "={{$json.payment_likelihood}}"
        }
      },
      "id": "log-to-communications",
      "name": "Log to Communications DB",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [2050, 200],
      "credentials": {
        "mongoDb": {
          "id": "1",
          "name": "MongoDB account"
        }
      },
      "notes": "📝 Track all interactions"
    },
    {
      "parameters": {
        "operation": "update",
        "collection": "invoices",
        "updateKey": "invoice_id",
        "fields": {
          "next_followup_date": "={{$json.prediction.best_contact_time}}",
          "last_followup_date": "={{$now.toISO()}}",
