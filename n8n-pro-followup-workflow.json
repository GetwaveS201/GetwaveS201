          "priority_score": "={{$json.priority_score}}",
          "ai_analysis": "={{$json.prediction}}",
          "followup_count": "={{$json.followup_count + 1 || 1}}"
        }
      },
      "id": "schedule-next-followup",
      "name": "Schedule Next Follow-up (Adaptive)",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [2250, 200],
      "credentials": {
        "mongoDb": {
          "id": "1",
          "name": "MongoDB account"
        }
      },
      "notes": "🔄 Adaptive scheduling based on AI predictions"
    },
    {
      "parameters": {
        "operation": "insert",
